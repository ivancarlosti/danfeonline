# Fiscal Hub Environment Configuration
# Copy this file and fill in your values before starting the container.

# ── Web Server ──────────────────────────────────────────────
# Port exposed to the Docker host machine
PORT=8080
# If you are using a reverse proxy (like Nginx), define the domain name here
DOMAIN=fiscalhub.example.com

# ── Meu Danfe API v2 ───────────────────────────────────────
MEUDANFE_API_BASE=https://api.meudanfe.com.br/v2
MEUDANFE_API_KEY=your-api-key-here
MEUDANFE_API_TIMEOUT=60

# ── CNPJá API ──────────────────────────────────────────────
CNPJA_API_BASE=https://api.cnpja.com
CNPJA_API_KEY=your-cnpja-api-key-here
CNPJA_API_TIMEOUT=30

# ── Authentication method (none, account, keycloak) ────────
AUTH_METHOD=none

# ── Account auth settings ───────────────────────────────────
ACCOUNT_LOGIN=
ACCOUNT_PASSWORD=

# ── Keycloak auth settings ──────────────────────────────────
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=fiscalhub
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
KEYCLOAK_REDIRECT_URI=https://fiscalhub.example.com/
KEYCLOAK_EMAIL_ACCOUNT=youremail@example.com
